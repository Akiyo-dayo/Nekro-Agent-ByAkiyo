# == 多实例配置区 ==

# 数据目录
NEKRO_DATA_DIR=

# 用于区分不同实例的前缀
INSTANCE_NAME=

# NA 自己的 DNS 主机名（可选，**一般不用填**；#47）
#
# 内置 NapCat 反连 NA 用 `ws://{主机名}:{端口}/onebot/v11/ws`。三份 compose 都已经把它
# 传进容器，默认值就是 NA 的容器名（`${INSTANCE_NAME}nekro_agent`），所以设了
# INSTANCE_NAME=na_a_ 之后什么都不用再配：容器名带前缀、反连地址也解析得到它。
# 只有容器名被你另行改掉（比如自己改了 compose 里的 container_name）时才需要显式覆盖：
# NEKRO_SELF_HOSTNAME=your_na_container_name
# ⚠️ 留空等于没设（取默认值）；不要写进仓库的 `.env.prod`，那份文件被打进镜像，
#    run_bot.py 会把其中 NEKRO_ 前缀的键无条件覆盖进环境，抹掉 compose 传进来的值。

# 端口配置 (对外开放的端口)
NEKRO_EXPOSE_PORT=8021
NAPCAT_EXPOSE_PORT=6099

# == 其他配置 (不建议修改) ==

# 端口配置 (不对宿主机开放)
POSTGRES_EXPOSE_PORT=5432
QDRANT_EXPOSE_PORT=6333

# 数据库配置
POSTGRES_HOST=${INSTANCE_NAME}nekro_postgres
POSTGRES_USER=nekro_agent
POSTGRES_PASSWORD=nekro_agent
POSTGRES_DATABASE=nekro_agent

# Qdrant 配置
QDRANT_URL=http://${INSTANCE_NAME}nekro_qdrant:6333

# == 密钥配置 (安装脚本自动填充) ==

# Qdrant API Key
QDRANT_API_KEY=

# OneBot 协议端接入令牌（部署级兜底值，install.sh 留空时会随机生成 32 位）
# 只管"没有自己那枚令牌的协议端"：单实例老部署、自动登记的待认领实例。
# 总后台建出来的实例按实例各自的令牌校验，不受这一项影响。
ONEBOT_ACCESS_TOKEN=

# 管理员密码
NEKRO_ADMIN_PASSWORD=

# JWT 两把签名密钥（install 脚本留空时各自随机生成 64 位字母数字；**已有值一律不覆盖**）
#
# ⚠️ 拿到这把密钥的人可以直接自签 admin 的令牌，登录口令不构成边界，所以别手抄示例值。
# 手填的话：两把互不相同、长度 >= 32，`openssl rand -hex 32`。
# 留空不是空密钥：容器里没配 / 为空时应用每次启动现场随机一把，只是重启后全员要重新登录。
# ⚠️ 换密钥 = 全部已签发令牌当场失效。启动日志里发现示例值 / 过短 / 两把相同会有 WARNING 点名。
NEKRO_JWT_SECRET_KEY=
NEKRO_JWT_REFRESH_SECRET_KEY=

# 模型组 api_key 的静态加密主密钥（可选）
#
# 留空**不等于不加密**：留空时应用会在数据目录里自动生成一把 0600 的密钥文件
# (<NEKRO_DATA_DIR>/credential_secret.key)，数据目录是 bind 挂进容器的，重建容器不会丢它。
# 填了这一项则密钥完全不落在数据目录里（打包整个数据目录也带不走），是推荐形态：
#   openssl rand -hex 32
#
# ⚠️ 安装脚本**有意不自动生成**这一项：自动生成会让运维手上多一份"不知道存在、也没备份"
#    的密钥，而它一丢 = 库里所有模型组的 API Key 全部解不开。要用就自己填、并自己备份。
# ⚠️ 换成一把与旧值无关的新密钥 = 存量密文当场作废（从"自动生成的密钥文件"迁到这里是
#    支持的：旧密钥自动降级为历史密钥，一次重启完成重新加密）。
# ⚠️ 它挡的是「库被 dump / 备份外流」，**挡不住宿主被拿下**。
#    <NEKRO_DATA_DIR>/configs/nekro-agent.yaml 里的 MODEL_GROUPS.*.API_KEY 不再含明文：
#    只有占位符 `nkmask:1`（这个组有 Key）或空串（没配 Key），升级后的首次启动就会掩码存量明文
#    （库里有当前密钥解不开的行时例外，见 docs/operations.md §1.5）。代价是 yaml 不再是丢密钥后的
#    恢复来源：**这把密钥（或数据目录里的 credential_secret.key）必须随备份一起保管**。
# 完整威胁模型见 nekro_agent/tools/credential_cipher.py，
# 上线判据见 docs/operations.md §1.5。
NEKRO_CREDENTIAL_SECRET_KEY=
