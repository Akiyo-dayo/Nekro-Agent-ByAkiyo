# 使用 Python 官方镜像作为基础镜像
FROM python:3.11-slim-bullseye

# 设置环境变量
# PIP_CACHE_DIR 必须显式指定：容器以 nobody 运行，而 nobody 的 HOME 是 /nonexistent，
# pip 默认的 $HOME/.cache/pip 落在一个建不出来的路径上，缓存被整体关掉——宿主机挂进来的
# /app/.pip_cache 因此从来没被读写过。指到挂载点上，动态装依赖才能真正命中缓存。
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    LANG=C.UTF-8 \
    PIP_CACHE_DIR=/app/.pip_cache

# 设置时区
RUN ln -sf /usr/share/zoneinfo/Asia/Shanghai /etc/localtime && \
    echo 'Asia/Shanghai' > /etc/timezone

# Debian 11 (bullseye) 已 EOL：deb.debian.org / debian-security 上它的包已被撤走（pool 里 404），
# 只剩 archive.debian.org。不改源的话下面第一条 `apt install` 就是 exit 100，镜像永远构建不出来。
# archive 的 Release 早已过了 Valid-Until，所以同时关掉有效期检查（签名校验仍然开着）。
# 长期出路是把基础镜像升到 bookworm（要同步处理包名差异，例如 libgl1-mesa-glx），不在这次改动里。
RUN printf '%s\n' \
        'deb http://archive.debian.org/debian bullseye main' \
        'deb http://archive.debian.org/debian bullseye-updates main' \
        'deb http://archive.debian.org/debian-security bullseye-security main' \
        > /etc/apt/sources.list && \
    echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99archive-bullseye

# 系统更新与基础工具安装
RUN apt update && apt install -y \
    curl \
    gnupg \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# 安装 Node.js 20.x
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt install -y nodejs && \
    apt clean && \
    rm -rf /var/lib/apt/lists/*

# 安装系统依赖
RUN apt update && apt install -y \
    # 编译工具
    build-essential \
    pkg-config \
    swig \
    # 系统库
    tzdata \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libffi-dev \
    libssl-dev \
    libmupdf-dev \
    # 可视化工具
    graphviz \
    # OCR相关
    tesseract-ocr \
    tesseract-ocr-chi-sim \
    && apt clean \
    && rm -rf /var/lib/apt/lists/*

# 安装 UV（使用官方推荐方式）
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /usr/local/bin/

# 安装 mplfonts（系统级）
RUN uv pip install --system mplfonts && mplfonts init

# 创建应用目录并设置权限
# .pip_cache 在镜像里也建出来：宿主机没挂载时（本地调试、单测镜像）pip 仍要有一个可写的
# 缓存目录，否则又退回到"缓存整体失效"
RUN mkdir -p /app /app/shared /app/packages /app/.pip_cache && \
    chown -R nobody:nogroup /app && \
    chmod -R 777 /app /app/shared /app/packages /app/.pip_cache && \
    chmod 755 /bin/bash

# 设置工作目录
WORKDIR /app

# 复制所有文件（沙盒项目较小，直接复制所有文件）
COPY . /app

# 使用 UV 安装项目依赖到系统 Python（保持与应用版本解耦）
RUN uv pip install --system -r pyproject.toml

CMD ["bash"]
