# =============================================================================
# NekroAgent 开发环境配置示例
# =============================================================================
# 复制此文件为 .env.dev 并根据实际情况修改配置值
# 使用命令启动: uv run poe dev
#
# 🚀 一键启动开发环境:
# 1. docker compose -f docker/docker-compose.dev.yml up -d
# 2. cp .env.example .env.dev
# 3. uv run poe dev

# =============================================================================
# 基础配置
# =============================================================================

# 数据目录 (默认: ./data/nekro_agent)
NEKRO_DATA_DIR=./data/nekro_agent

# =============================================================================
# 数据库配置 (已预配置连接开发 Docker 服务)
# =============================================================================

# PostgreSQL 数据库配置
NEKRO_USE_ENV_DATABASE=true
NEKRO_POSTGRES_HOST=127.0.0.1
NEKRO_POSTGRES_PORT=5433
NEKRO_POSTGRES_USER=nekro_agent
NEKRO_POSTGRES_PASSWORD=nekro_agent
NEKRO_POSTGRES_DATABASE=nekro_agent_dev

# Qdrant 向量数据库配置
NEKRO_USE_ENV_QDRANT=true
NEKRO_QDRANT_URL=http://127.0.0.1:6334
NEKRO_QDRANT_API_KEY=your-qdrant-api-key

# =============================================================================
# 安全配置（下面三项是「必须替换」的占位值，不是能直接用的示例）
# =============================================================================

# JWT 签名密钥：两把必须各自随机生成、互不相同、长度 >= 32：
#   openssl rand -hex 32
# ⚠️ 拿到这把密钥的人可以直接自签 `sub=admin` 的令牌，登录口令不构成边界。
#    所以这里**不再给能直接用的示例值**（以前是一对看起来能用的「开发固定值」，
#    手抄这份示例起家的部署就这样继承了一把公开的密钥）。
# 逐字保留 CHANGE_ME 占位 = 启动日志里会有一条 WARNING 点名它（不拒绝启动）。
# 想省事的开发机也可以整行删掉 / 留空：没设或为空时应用每次启动现场随机一把，
# 代价只是重启后要重新登录；空值**不会**变成空密钥。
# ⚠️ 换密钥 = 全部已签发令牌当场失效。
NEKRO_JWT_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32
NEKRO_JWT_REFRESH_SECRET_KEY=CHANGE_ME_run_openssl_rand_hex_32_again

# 访问令牌过期天数
NEKRO_ACCESS_TOKEN_EXPIRE_DAYS=30

# 凭据静态加密密钥（模型组 api_key 在数据库里的加密密钥）
#
# 留空**不等于不加密**：没配这一项时，应用会在数据目录里自动生成一把 0600 的密钥文件
# (<NEKRO_DATA_DIR>/credential_secret.key) 并用它加密，于是"什么都不配"的部署仍然落在
# 「库被 dump 也读不出 API Key」这一侧。配了这一项则密钥完全不落在数据目录里
# （备份整个数据目录也带不走），是推荐形态：openssl rand -hex 32
#
# ⚠️ 它挡的是「数据库被 dump / 备份外流」，**挡不住宿主被拿下**——密钥就在同一台机器上。
# ⚠️ 配置文件那一份不再含明文：<NEKRO_DATA_DIR>/configs/nekro-agent.yaml 里的
#    MODEL_GROUPS.*.API_KEY 只有占位符 `nkmask:1`（这个组有 Key）或空串（没配 Key）两种形态，
#    升级后的首次启动就会掩码存量明文（库里有当前密钥解不开的行时例外，见 docs/operations.md §1.5）。
#    代价是 yaml 不再是丢密钥后的恢复来源：**这把密钥（或数据目录里的 credential_secret.key）
#    必须随备份一起保管**。
# ⚠️ 换掉这个值 = 库里存量密文全部作废（从"自动生成的密钥文件"迁到这里是支持的，
#    旧密钥会被当成历史密钥自动重新加密；但换成一把全新的值就是真轮换）。
# ⚠️ **Docker 部署不看本文件**：容器里那份 `.env.prod` 是打进镜像的，改不到。
#    Docker 请填 `docker/.env`（三份 compose 的 environment: 已透传这一项），
#    并且**不要**把它写进仓库的 `.env.prod` —— run_bot.py 会把该文件里 NEKRO_ 前缀的键
#    无条件覆盖进 os.environ，一行空值就把 compose 传进来的真密钥抹掉了。
# 完整威胁模型见 nekro_agent/tools/credential_cipher.py，上线判据见
# docs/operations.md §1.5。
NEKRO_CREDENTIAL_SECRET_KEY=

# loguru 异常诊断：在 traceback 里逐帧渲染局部变量 (默认: false)
# 打开之后排障信息更全（能直接看到出事那一刻每个变量等于什么），代价是那份文本由 loguru
# 从帧对象里直接 repr 出来、**不经过项目里任何一层脱敏**，于是数据库口令、API Key、
# 整份请求体都会原样落进 app.log 与 stdout。loguru 官方文档也点名这个选项生产环境应关闭。
# 关掉它不影响异常类型、异常消息、完整调用栈——那三样照常记录。
# 只在自己的开发机上设 true；任何会有真实用户数据的部署都保持 false。
NEKRO_LOG_DIAGNOSE=false

# 允许下载指向内网/回环地址的外部资源 (默认: false)
# 聊天消息中的图片链接由发送方任意构造，默认拒绝内网地址以防止 SSRF 探测。
# 仅当协议端确实从内网地址提供资源时才开启，开启即意味着任意消息发送方可探测本机内网。
# 这是个"全开"开关，粒度很粗；只需要放行个别网段时优先用下面的 EXTRA_ALLOWED_NETWORKS。
NEKRO_ALLOW_PRIVATE_NETWORK_DOWNLOAD=false

# 额外视为"非内网"的网段，逗号分隔 CIDR (默认: 198.18.0.0/15)
# 默认值是给透明代理准备的：Shadowrocket / Clash 等会把域名的 DNS 结果替换成 198.18.0.0/15
# 里的 Fake-IP，流量实际由代理按原域名转发，这个地址并不指向你网络里的任何一台主机 ——
# 不放行会导致宿主机开了代理后，含图片的消息整条收不到。没开代理时这一段按 RFC 2544 不得
# 出现在公网，连过去只会超时，所以默认放行不会削弱防护。
# 也可用于精确放行单台内网机器（如 NapCat 在 10.0.0.5）：写 10.0.0.5/32 比直接把上面的
# ALLOW_PRIVATE_NETWORK_DOWNLOAD 打开安全得多。
# 注意：写进这里的网段等于声明"它不是我的内网"，对租户提交的接口地址同样放行；
# 放行非公网网段时启动日志会有告警。置空即恢复"只允许公网地址"的严格行为。
NEKRO_DOWNLOAD_EXTRA_ALLOWED_NETWORKS=198.18.0.0/15

# =============================================================================
# 服务配置
# =============================================================================

# 暴露端口 (默认: 8021)
NEKRO_EXPOSE_PORT=8021

# 前端静态文件目录
NEKRO_STATIC_DIR=./frontend/dist

# WebUI 管理员密码：这就是 `admin` 账号的登录口令（没有第二个真相来源），必须替换成随机强口令：
#   openssl rand -base64 24
# 以前这里是 `admin`，逐字照抄示例的部署等于给总后台留了公开口令。
# 逐字保留 CHANGE_ME 占位或长度 < 12 = 启动日志里会有一条 WARNING 点名它（不拒绝启动）。
# 留空 = admin 无法登录（不是弱口令）。
NEKRO_ADMIN_PASSWORD=CHANGE_ME_set_a_strong_password

# =============================================================================
# NoneBot 配置
# =============================================================================

# NoneBot 环境
ENVIRONMENT=dev

# 驱动器配置
DRIVER=~fastapi

# 主机和端口
HOST=0.0.0.0
PORT=8021

# 日志级别
LOG_LEVEL=DEBUG

# OneBot 协议端接入令牌（部署级兜底值，留空 = 对下述协议端不做校验）
#
# 只管两类协议端：① 单实例老部署；② 自行连入后被自动登记为待认领实例的协议端。
# 总后台建出来的实例各有各的令牌（建实例时生成、下发进 NapCat 配置），
# 握手时按实例校验，**填不填这一项都不影响它们**。
# 判据见 nekro_agent/adapters/onebot_v11/core/access_token.py。
ONEBOT_ACCESS_TOKEN=
