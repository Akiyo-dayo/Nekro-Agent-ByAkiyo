DRIVER=~fastapi+~websockets
HOST=0.0.0.0
PORT=8021
# OneBot 协议端接入令牌（部署级兜底值）
#
# 它是"没有自己那枚令牌的协议端"要出示的值：单实例老部署、以及自行连入后被自动登记
# 为待认领实例的协议端。总后台建出来的实例各有各的令牌，握手时按实例校验，
# **不受这一项影响**（见 nekro_agent/adapters/onebot_v11/core/access_token.py）。
#
# 留空 = 对上述那批协议端不做校验，任何人知道 ws 地址就能冒充协议端接入。
# 生产部署请填一个 >=24 字符的随机值（docker/install.sh 会自动生成）。
#
# ⚠️ 本文件被打进镜像，容器部署请在 docker/.env 里配置同名变量：
#    容器环境变量优先级高于本文件（nonebot 的 DotEnvSettingsSource：os.environ 覆盖 env 文件）。
# ⚠️ 裸机部署（bot --env=prod）改这里即可；run_bot.py 只把 NEKRO_ 前缀的键搬进
#    os.environ，所以本项只对 nonebot 与 NA 的适配器配置解析生效，这是有意的。
ONEBOT_ACCESS_TOKEN=